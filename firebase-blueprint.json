{
  "entities": {
    "Account": {
      "title": "Account",
      "description": "Root account model indexed by Firebase User ID",
      "type": "object",
      "properties": {
        "accountId": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "status": { "type": "string" },
        "organizationName": { "type": "string" },
        "collegeName": { "type": "string" },
        "tagline": { "type": "string" },
        "logo": { "type": "string" }
      },
      "required": ["accountId", "email", "createdAt"]
    },
    "Organizer": {
      "title": "Organizer",
      "description": "Office bearer or organizer record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "name": { "type": "string" },
        "position": { "type": "string" },
        "display_order": { "type": "number" },
        "photo": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "academic_year": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "accountId", "name", "position"]
    },
    "Program": {
      "title": "Program",
      "description": "Program or event record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "date": { "type": "string" },
        "place": { "type": "string" },
        "audience": { "type": "string" },
        "description": { "type": "string" },
        "poster": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "accountId", "name", "date"]
    },
    "ProgramCategory": {
      "title": "ProgramCategory",
      "description": "Program category entity belonging to account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "accountId", "name"]
    },
    "SP_Portal": {
      "title": "SP_Portal",
      "description": "Student Points Portal setting node",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "submissionsAllowed": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "SP_Organization": {
      "title": "SP_Organization",
      "description": "Class sub-organization inside Student Points Portal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "name": { "type": "string" },
        "className": { "type": "string" },
        "logo": { "type": "string" },
        "description": { "type": "string" },
        "leader": { "type": "string" },
        "contactDetails": { "type": "string" },
        "status": { "type": "string" },
        "totalPoints": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "portalId", "name", "className"]
    },
    "SP_User": {
      "title": "SP_User",
      "description": "Sub-organization or Admin login account for Student Points Portal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "organizationId": { "type": "string" },
        "email": { "type": "string" },
        "passwordHash": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "portalId", "email", "passwordHash", "role"]
    },
    "SP_Category": {
      "title": "SP_Category",
      "description": "Achievement point categories customizable by NSU Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "name": { "type": "string" },
        "defaultPoints": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "portalId", "name"]
    },
    "SP_Achievement": {
      "title": "SP_Achievement",
      "description": "Sub-organization achievement submissions for points evaluation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "organizationId": { "type": "string" },
        "title": { "type": "string" },
        "programName": { "type": "string" },
        "categoryId": { "type": "string" },
        "date": { "type": "string" },
        "place": { "type": "string" },
        "description": { "type": "string" },
        "participantsCount": { "type": "number" },
        "responsiblePerson": { "type": "string" },
        "requestedPoints": { "type": "number" },
        "additionalNotes": { "type": "string" },
        "status": { "type": "string" },
        "reviewNotes": { "type": "string" },
        "awardedPoints": { "type": "number" },
        "reviewerId": { "type": "string" },
        "submittedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "portalId", "organizationId", "title", "programName", "categoryId", "date", "status"]
    },
    "SP_Media": {
      "title": "SP_Media",
      "description": "Saved media attachment records for Student Points Portal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "achievementId": { "type": "string" },
        "organizationId": { "type": "string" },
        "accountId": { "type": "string" },
        "proofType": { "type": "string" },
        "fileName": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileSize": { "type": "number" },
        "mimeType": { "type": "string" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["id", "portalId", "achievementId", "organizationId", "proofType", "fileUrl"]
    },
    "SP_Transaction": {
      "title": "SP_Transaction",
      "description": "Individual point transaction audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "organizationId": { "type": "string" },
        "achievementId": { "type": "string" },
        "categoryId": { "type": "string" },
        "points": { "type": "number" },
        "type": { "type": "string" },
        "reason": { "type": "string" },
        "awardedBy": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "portalId", "organizationId", "points", "type", "reason"]
    },
    "SP_Competition": {
      "title": "SP_Competition",
      "description": "Competitions or evaluation periods",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "name": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "portalId", "name", "startDate", "endDate"]
    },
    "SP_Award": {
      "title": "SP_Award",
      "description": "Award categories and winners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "evaluationPeriod": { "type": "string" },
        "winnerOrganizationId": { "type": "string" },
        "winnerOrganizationName": { "type": "string" },
        "awardDate": { "type": "string" },
        "certificateUrl": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "portalId", "name", "winnerOrganizationId", "awardDate"]
    },
    "SP_Announcement": {
      "title": "SP_Announcement",
      "description": "Published announcements from NSU Super Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "publishedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "portalId", "title", "content", "publishedBy", "createdAt"]
    },
    "SP_Notification": {
      "title": "SP_Notification",
      "description": "Portal notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "userId": { "type": "string" },
        "organizationId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "portalId", "title", "message", "createdAt"]
    },
    "SP_AuditLog": {
      "title": "SP_AuditLog",
      "description": "Portal auditing history logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "portalId", "action", "details", "timestamp"]
    },
    "SP_RegistrationLink": {
      "title": "SP_RegistrationLink",
      "description": "Registration links generated by Admin for sub-org self-enrollment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "label": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "organizationId": { "type": "string" },
        "createdAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "portalId", "label", "status", "createdAt"]
    },
    "SP_PortalLink": {
      "title": "SP_PortalLink",
      "description": "Account-specific Points Portal link relationship",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mainAccountId": { "type": "string" },
        "mainAccountEmail": { "type": "string" },
        "organizationId": { "type": "string" },
        "pointsPortalId": { "type": "string" },
        "secureToken": { "type": "string" },
        "pointsPortalSlug": { "type": "string" },
        "pointsPortalUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "not_generated", "disabled"] }
      },
      "required": ["id", "mainAccountId", "mainAccountEmail", "pointsPortalId", "secureToken", "status"]
    },
    "SP_PortalToken": {
      "title": "SP_PortalToken",
      "description": "Public unguessable token lookup mapping to a pointsPortalId",
      "type": "object",
      "properties": {
        "secureToken": { "type": "string" },
        "mainAccountId": { "type": "string" },
        "mainAccountEmail": { "type": "string" },
        "portalId": { "type": "string" },
        "portalName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["secureToken", "mainAccountId", "portalId", "status"]
    },
    "SP_Rejection": {
      "title": "SP_Rejection",
      "description": "Persistent rejection access record for sub-organizations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "organizationId": { "type": "string" },
        "organizationName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "rejectedAt": { "type": "string" }
      },
      "required": ["id", "portalId", "organizationId", "organizationName", "userEmail", "status", "rejectedAt"]
    },
    "SubWing": {
      "title": "SubWing",
      "description": "Sub-Wing program management partner or office branch",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "portalId": { "type": "string" },
        "name": { "type": "string" },
        "president": { "type": "string" },
        "contactDetails": { "type": "string" },
        "email": { "type": "string" },
        "passwordHash": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "portalId", "name", "email", "passwordHash"]
    },
    "SubWingPortal": {
      "title": "SubWingPortal",
      "description": "Sub-Wing Program Portal configuration document linking portalId to parent accountId",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "accountId", "status"]
    }
  },
  "firestore": {
    "/sub_wing_portals/{portalId}": {
      "schema": "SubWingPortal",
      "description": "Global configuration document lookup mapping portalId to parent accountId"
    },
    "/accounts/{accountId}": {
      "schema": "Account",
      "description": "User account documents indexed by Firebase Auth UID"
    },
    "/organizers/{organizerId}": {
      "schema": "Organizer",
      "description": "Organizers belonging to account"
    },
    "/programs/{programId}": {
      "schema": "Program",
      "description": "Programs belonging to account"
    },
    "/program_categories/{categoryId}": {
      "schema": "ProgramCategory",
      "description": "Program categories belonging to account"
    },
    "/sp_portals/{portalId}": {
      "schema": "SP_Portal",
      "description": "Student points portal root node"
    },
    "/sp_organizations/{orgId}": {
      "schema": "SP_Organization",
      "description": "Class organizations"
    },
    "/sp_rejections/{rejId}": {
      "schema": "SP_Rejection",
      "description": "Persistent rejection access control records"
    },
    "/sp_users/{userId}": {
      "schema": "SP_User",
      "description": "Class login credentials"
    },
    "/sp_categories/{categoryId}": {
      "schema": "SP_Category",
      "description": "Achievement point evaluation categories"
    },
    "/sp_achievements/{achievementId}": {
      "schema": "SP_Achievement",
      "description": "Achievement submissions"
    },
    "/sp_media/{mediaId}": {
      "schema": "SP_Media",
      "description": "Proof files details"
    },
    "/sp_transactions/{transactionId}": {
      "schema": "SP_Transaction",
      "description": "Point transactions log"
    },
    "/sp_competitions/{competitionId}": {
      "schema": "SP_Competition",
      "description": "Competitions and periods"
    },
    "/sp_awards/{awardId}": {
      "schema": "SP_Award",
      "description": "Awards registry"
    },
    "/sp_announcements/{announcementId}": {
      "schema": "SP_Announcement",
      "description": "Announcements"
    },
    "/sp_notifications/{notificationId}": {
      "schema": "SP_Notification",
      "description": "System alerts and notification items"
    },
    "/sp_audit_logs/{logId}": {
      "schema": "SP_AuditLog",
      "description": "Portal audit log record"
    },
    "/sp_registration_links/{linkId}": {
      "schema": "SP_RegistrationLink",
      "description": "Sub-org registration slot tokens"
    },
    "/sp_portal_links/{mainAccountId}": {
      "schema": "SP_PortalLink",
      "description": "Account-specific Points Portal link configuration"
    },
    "/sp_portal_tokens/{secureToken}": {
      "schema": "SP_PortalToken",
      "description": "Secure unguessable token lookup mapping to portalId"
    },
    "/sub_wings/{subWingId}": {
      "schema": "SubWing",
      "description": "Onboarded sub-wing partner registry"
    }
  }
}
