rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Accounts collection indexed by Firebase UID
    match /accounts/{accountId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == accountId;
    }

    // Public organizations directory
    match /public_organizations/{orgId} {
      allow read, write: if true;
    }

    // Organizers collection isolated by accountId
    match /organizers/{organizerId} {
      allow read: if true;
      allow delete: if request.auth != null && resource.data.accountId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.accountId == request.auth.uid;
      allow update: if request.auth != null && resource.data.accountId == request.auth.uid && request.resource.data.accountId == request.auth.uid;
    }

    // Programs collection
    match /programs/{programId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null && resource.data.accountId == request.auth.uid;
    }

    // Program Permissions collection
    match /program_permissions/{permissionId} {
      allow read, create, update, delete: if true;
    }

    // Sub-Wings collection
    match /sub_wings/{subWingId} {
      allow read, create, update, delete: if true;
    }

    // Sub-Wing Portals collection
    match /sub_wing_portals/{portalId} {
      allow read, create, update, delete: if true;
    }

    // Program categories collection
    match /program_categories/{categoryId} {
      allow read: if true;
      allow delete: if request.auth != null && resource.data.accountId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.accountId == request.auth.uid;
      allow update: if request.auth != null && resource.data.accountId == request.auth.uid && request.resource.data.accountId == request.auth.uid;
    }

    // Financial accounts collection isolated by accountId
    match /financial_accounts/{accId} {
      allow read, delete: if request.auth != null && resource.data.accountId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.accountId == request.auth.uid;
      allow update: if request.auth != null && resource.data.accountId == request.auth.uid && request.resource.data.accountId == request.auth.uid;
    }

    // Incomes collection isolated by accountId
    match /incomes/{incId} {
      allow read, delete: if request.auth != null && resource.data.accountId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.accountId == request.auth.uid;
      allow update: if request.auth != null && resource.data.accountId == request.auth.uid && request.resource.data.accountId == request.auth.uid;
    }

    // Expenses collection isolated by accountId
    match /expenses/{expId} {
      allow read, delete: if request.auth != null && resource.data.accountId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.accountId == request.auth.uid;
      allow update: if request.auth != null && resource.data.accountId == request.auth.uid && request.resource.data.accountId == request.auth.uid;
    }

    // Transfers collection isolated by accountId
    match /transfers/{transId} {
      allow read, delete: if request.auth != null && resource.data.accountId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.accountId == request.auth.uid;
      allow update: if request.auth != null && resource.data.accountId == request.auth.uid && request.resource.data.accountId == request.auth.uid;
    }

    // Loans collection isolated by accountId
    match /loans/{loanId} {
      allow read, delete: if request.auth != null && resource.data.accountId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.accountId == request.auth.uid;
      allow update: if request.auth != null && resource.data.accountId == request.auth.uid && request.resource.data.accountId == request.auth.uid;
    }

    // Repayments collection isolated by accountId
    match /repayments/{repId} {
      allow read, delete: if request.auth != null && resource.data.accountId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.accountId == request.auth.uid;
      allow update: if request.auth != null && resource.data.accountId == request.auth.uid && request.resource.data.accountId == request.auth.uid;
    }

    // Audit logs collection isolated by accountId
    match /audit_logs/{logId} {
      allow read, delete: if request.auth != null && resource.data.accountId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.accountId == request.auth.uid;
      allow update: if request.auth != null && resource.data.accountId == request.auth.uid && request.resource.data.accountId == request.auth.uid;
    }

    // STUDENT POINTS MANAGEMENT PORTAL (sp_) COLLECTIONS
    match /sp_portals/{portalId} {
      allow read: if true;
      allow write: if true;
    }
    match /sp_organizations/{orgId} {
      allow read: if true;
      allow write: if true;
    }
    match /sp_rejections/{rejId} {
      allow read, write: if true;
    }
    match /sp_users/{userId} {
      allow read, write: if true;
    }
    match /sp_categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    match /sp_achievements/{achievementId} {
      allow read: if true;
      // Creation is strictly blocked if submissions are turned off in the portal configuration
      allow create: if request.resource.data.portalId != null &&
        (!exists(/databases/$(database)/documents/sp_portals/$(request.resource.data.portalId)) ||
         get(/databases/$(database)/documents/sp_portals/$(request.resource.data.portalId)).data.submissionsAllowed != false);
      allow update, delete: if true;
    }
    match /sp_media/{mediaId} {
      allow read: if true;
      allow write: if true;
    }
    match /sp_transactions/{transactionId} {
      allow read: if true;
      allow write: if true;
    }
    match /sp_competitions/{competitionId} {
      allow read: if true;
      allow write: if true;
    }
    match /sp_awards/{awardId} {
      allow read: if true;
      allow write: if true;
    }
    match /sp_announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }
    match /sp_notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }
    match /sp_audit_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }
    match /sp_registration_links/{linkId} {
      allow read: if true;
      allow write: if true;
    }
    match /sp_members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    // Portal links isolated by mainAccountId (only owner can read or write)
    match /sp_portal_links/{accountId} {
      allow read, write: if request.auth != null && request.auth.uid == accountId;
    }

    // Portal tokens (for public lookup: individual get allowed, list disallowed to prevent scraping, writes restricted to owner)
    match /sp_portal_tokens/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.mainAccountId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.mainAccountId == request.auth.uid;
    }
  }
}
